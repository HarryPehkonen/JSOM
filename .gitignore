# Build directories
build/
build_bench/
build-*/
CMakeFiles/
_deps/

# Tooling caches and local state
.cache/
.git_old/
.claude/settings.local.json

# Local CI: the config is per-machine (see .ci.env.example), the logs are scratch.
# .ci/tidy-baseline.txt IS committed — it is the shared bar for the tidy gate.
.ci.env
.ci-logs/
# The pristine stage's scratch tree and its reused build directory (see tools/ci.sh).
.ci/pristine/
.ci/pristine-build/

# Compiled files
*.o
*.a
*.so
*.dylib
*.exe

# Debug/test files
debug_*
test_*.json
*.txt
!CMakeLists.txt
!requirements.txt
# The tidy gate's accepted-findings list is a REPO file, not a scratch file: the comment
# at the top of .ci/ says it is committed, and tools/ci.sh --write-tidy-baseline prints
# `git add .ci/tidy-baseline.txt` as the next step. Without this negation that command is
# refused by the *.txt rule above ("The following paths are ignored by one of your
# .gitignore files", exit 1), so the one documented way to accept findings did nothing.
!/.ci/tidy-baseline.txt

# Python
venv/
__pycache__/
*.pyc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Fuzzing
fuzz_jsom
crash-*
leak-*
timeout-*
corpus/
