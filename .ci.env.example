# JSOM local CI configuration.
#
# Copy to .ci.env (which is gitignored) and edit what you need. This file is
# documentation: every knob below has a default in tools/ci.sh, so with no .ci.env
# at all the repo behaves exactly as described here.
#
#   cp .ci.env.example .ci.env

# Parallel build jobs for the build/asan/pristine stages.
CI_JOBS=4

# Fuzz seconds in the `fuzz` stage. This is a SMOKE test that the target still builds
# and still survives a few thousand inputs — the long campaigns belong to the nightly
# cron, not to a push. Raise it if a change touches input handling.
# 20 rather than 10 since 2026-09-20: the harness now runs three readings per input
# (JSOM_FUZZ_READINGS), which costs ~9x the exec/s of the byte reading alone, so the same
# wall clock does ~9x less byte work. This value buys that back. Keep in step with the
# default in tools/ci.sh (${VAR:-value} means the FIRST value set wins, so a stale copy here
# silently overrides the script's default when .ci.env is copied from this file).
CI_FUZZ_SECONDS=20

# Which readings the fuzz target runs. They cost very different amounts, so a long
# byte-focused campaign can ask for one while the gate keeps proving all three are alive:
#   all         (default) byte + structured + mutator
#   byte        the committed behaviour alone: ~8,200 exec/s, no structure, no oracle laws
#   structured  JSONFuzz's generator feeds the oracles instead of the raw input
#   mutator     jsonfuzz::mutate restructures each input before the oracles run
#   comma list  e.g. "byte,mutator"
# An unknown name is a startup error, deliberately: a typo that quietly dropped a reading
# would leave the gate green while checking less. The reach guard requires exactly the
# ENABLED readings, so deselecting one is a decision rather than a starved guard.
CI_FUZZ_READINGS=all

# Offline override for the JSONFuzz source the `fuzz` stage builds against. Empty means
# the stage FETCHES JSONFuzz at the pin recorded in CMakeLists.txt — that is the default on
# purpose, because the gate's provenance is the pinned revision. Set it to a local checkout
# to run the fuzz stage offline, or while changing both repos. Worth knowing: whichever
# checkout is used, the stage prints its revision ("jsonfuzz: v0.1.0 (d375d7a), fetched"),
# and it passes -U to the configure so a value left in a build dir's cache cannot outrank
# either the pin or this setting.
CI_FUZZ_JSONFUZZ_DIR=

# Stages run when no stage names are given on the command line.
CI_DEFAULT_STAGES="tree format kitprobes build tests consumer asan fuzz tsan std cli conform docs tidy pristine"

# 1 = a missing tool (clang-format, clang-tidy) FAILS the run instead of SKIPping it.
# Set to 1 on a machine that is supposed to have them, so a silently missing gate
# cannot pass unnoticed.
CI_STRICT_TOOLS=0

# 1 = keep the pristine-build temp directory after a run (path is printed).
CI_KEEP_TMP=0

# Where per-stage output goes. Gitignored; on failure the tail is printed and the
# path is named.
CI_LOG_DIR=.ci-logs

# clang-tidy baseline — OPTIONAL. With no file, the tidy stage requires ZERO findings
# (which is where the repo stands today). Create one only to tolerate findings you
# inherited, and create it with the gate — never by hand:
#
#   tools/ci.sh --write-tidy-baseline
#   git add .ci/tidy-baseline.txt && git commit -m "ci: accept the inherited clang-tidy findings"
#
# That one command runs the build stage (tidy refuses to run without
# $CI_BUILD_DIR/compile_commands.json — the build stage is what writes it), runs tidy,
# and writes every finding it reports into this file. Its tidy stage failing during that
# capture is expected — with no baseline yet, every inherited finding counts as new.
#
# The comparison normalises BOTH sides (tidy_key in tools/ci.sh): the repo root is
# stripped from every path and `:line:column` is stripped, so a baseline captured in one
# clone still describes a checkout at another path. A raw copy of .ci-logs/tidy.log
# matches neither, so every baselined finding reads as new and the tidy stage is
# permanently red — there is exactly one definition of the form, and it lives in the
# script; ask the script for the file.
CI_TIDY_BASELINE=.ci/tidy-baseline.txt

# Build directories. The asan one is separate on purpose so sanitizer objects never
# mix with the normal build.
CI_BUILD_DIR=build
CI_ASAN_BUILD_DIR=build-asan
