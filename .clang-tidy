HeaderFilterRegex: 'include/jsom/.*\.hpp$|tests/.*\.cpp$|src/.*\.cpp$'
# Curated 2026-09-08: was -*,bugprone-*,performance-*,readability-*,modernize-*,portability-*
# (120 unfixable-noise findings — style families fight this codebase's conventions:
# pragma once everywhere, auto lambdas, numeric constants in template machinery).
# Value-only set: real bug patterns + performance. Style lives in clang-format.
Checks: '-*,bugprone-*,-bugprone-easily-swappable-parameters,performance-*'

CheckOptions:
  # Ignore complexity from macro expansions (fixes Google Test warnings)
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
  - key: readability-function-cognitive-complexity.Threshold
    value: 30
  # Allow trailing return types for any function, not just complex ones
  - key: modernize-use-trailing-return-type.UseTrailingReturnType
    value: true
  - key: readability-function-size.LineThreshold
    value: 30
