# JSON tokens for libFuzzer. Terminals of the RFC 8259 grammar.
# Syntax: name="literal"; \xNN allowed. Verified by dumping the file.
open_obj="{"
close_obj="}"
open_arr="["
close_arr="]"
colon=":"
comma=","
quote="\"""
backslash="\\"
nul="null"
true_lit="true"
false_lit="false"
minus="-"
plus="+"
zero="0"
digit="0123456789"
exp_lower="e"
exp_upper="E"
exp_plus=""e+""
dot="."
esc_u="\\u"
hex_digits="0123456789abcdefABCDEF"
esc_quote="\\\""
esc_backslash="\\\\"
esc_slash="\\/"
esc_n="\\n"
esc_t="\\t"
esc_cap_u="\\U"
surrogate_hi="\\ud83d"
surrogate_lo="\\ude00"
ws_space=" "
ws_tab="\x09"
ws_nl="\x0a"
big_exp="1e308"
leading_zero="01"
deep_open="[[[[[[[[[["
keys="{\"a\":1,\"b\":2"
