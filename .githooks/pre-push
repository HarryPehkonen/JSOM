#!/usr/bin/env bash
#
# pre-push: the full gate, on the tree you are about to publish.
#
# Requires a clean worktree (nothing uncommitted), then proves the COMMITTED tree is
# complete by building and testing it from a pristine checkout of HEAD.
#
# A TAG-ONLY push is skipped: re-running ~6 minutes of gates to publish a tag is waste, as
# long as every tag points at a commit that is already on a remote branch — that commit was
# validated when the branch was pushed. A tag pointing anywhere else (a local-only commit)
# still runs the full gate, so nothing unpublished can slip through. Deletions are ignored.
#
# from AI-DEV-STARTER (plunk-in kit), templates/hooks/pre-push. Deviation: this hook passes
# this repo's own fourteen-stage list (the kit's C++ template pins eight) and adds the tag-only
# fast path above, which the kit does not have; the kit's deno/python branch is dropped, and
# a missing tools/ci.sh still fails the push closed (exec returns 127). The kit says to
# record edits to its files in INCIDENTS.md; this repo has no INCIDENTS.md, so the deviation
# is stated here instead.
#
# Deliberate bypass: git push --no-verify
zero=0000000000000000000000000000000000000000
only_tags=1
unpublished=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    if [ "$local_sha" = "$zero" ]; then
        continue # deletion: nothing to build
    fi
    case "$remote_ref" in
    refs/tags/*)
        if ! git branch -r --contains "$local_sha" 2>/dev/null | grep -q .; then
            unpublished=1
        fi
        ;;
    *)
        only_tags=0
        ;;
    esac
done

if [ "$only_tags" -eq 1 ] && [ "$unpublished" -eq 0 ]; then
    printf 'pre-push: tag-only push, and the tagged commit is already on a remote branch — gates skipped\n'
    exit 0
fi

# No stage list here on purpose: the default set lives in tools/ci.sh alone, so adding a
# stage does not need this hook edited too.
exec "$(git rev-parse --show-toplevel)/tools/ci.sh" --require-clean
